<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CompressionEnabled>false</CompressionEnabled> <!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->
    <!-- Keep the content root (umbraco/, ClientApp/, wwwroot/) on this folder, also when started with dotnet run from the repo root -->
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
    <AssemblyName>TsugiteUmbraco</AssemblyName>
    <RootNamespace>TsugiteUmbraco</RootNamespace>
    <!-- Keep the Vite client's node_modules out of the item globs -->
    <DefaultItemExcludes>$(DefaultItemExcludes);ClientApp\node_modules\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" Version="17.7.0" />
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="17.7.0" />
    <PackageReference Include="Umbraco.Forms" Version="17.5.1" />
    <PackageReference Include="Vite.AspNetCore" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Umbraco.AI: pinned to the 17.x line. The package major follows the Umbraco major; 18.x needs Umbraco 18. -->
    <PackageReference Include="Umbraco.AI" Version="17.3.5" />
    <PackageReference Include="Umbraco.AI.Anthropic" Version="17.1.1" />
    <PackageReference Include="Umbraco.AI.OpenAI" Version="17.2.1" />
    <PackageReference Include="Umbraco.AI.Agent" Version="17.1.7" />
    <!-- "Copilot" is Umbraco's own backoffice chat sidebar for Umbraco.AI.Agent; no Microsoft/GitHub Copilot dependency. -->
    <PackageReference Include="Umbraco.AI.Agent.Copilot" Version="17.0.5" />
    <!-- Prompt templates for Umbraco.AI; same 17.x pinning rule -->
    <PackageReference Include="Umbraco.AI.Prompt" Version="17.2.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Umbraco.Automate: pinned to the 17.x line like Umbraco.AI; 18.x needs Umbraco 18. Built on WorkflowCore. -->
    <PackageReference Include="Umbraco.Automate" Version="17.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Remove RazorCompileOnBuild and RazorCompileOnPublish when not using ModelsMode InMemoryAuto -->
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>

</Project>
